/*
 * Board overlay for Seeed XIAO BLE (nRF52840 Sense)
 *
 * PWM: uses PWM0 on pin P0.02 (D0 / A0 on the XIAO pinout).
 *      Change the pin to whichever GPIO your servo signal wire is connected to.
 *
 * ADC: reads from AIN0 (P0.02). If the potentiometer and servo share
 *      different pins, update the io-channels and pwm-pin accordingly.
 *      On the XIAO BLE the analogue-capable pins are A0–A5 (P0.02–P0.07).
 */

/ {
    zephyr,user {
        /* AIN1 = P0.03 (XIAO pin A1) – potentiometer wiper */
        io-channels = <&adc 1>;
    };
};

&adc {
    status = "okay";
    #address-cells = <1>;
    #size-cells = <0>;

    channel@1 {
        reg = <1>;
        zephyr,gain = "ADC_GAIN_1_6";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,input-positive = <NRF_SAADC_AIN1>; /* P0.03 */
        zephyr,resolution = <12>;
    };
};

/* PWM0 on P0.02 (XIAO pin A0/D0) – servo signal */
&pwm0 {
    status = "okay";
    pinctrl-0 = <&pwm0_default>;
    pinctrl-1 = <&pwm0_sleep>;
    pinctrl-names = "default", "sleep";
};

&pinctrl {
    pwm0_default: pwm0_default {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 0, 2)>; /* P0.02 */
        };
    };
    pwm0_sleep: pwm0_sleep {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 0, 2)>;
            low-power-enable;
        };
    };
};
